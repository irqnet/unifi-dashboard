# =====================================================================
#  UniFi Network Dashboard – Konfiguration
#  Kopieren nach .env und anpassen:  cp .env.example .env
# =====================================================================

# --- UniFi Controller --------------------------------------------------
# UniFi OS (UDM/UCG/Cloud Key Gen2+) oder Self-Hosted Controller
UNIFI_CONTROLLER_URL=https://192.168.1.1
# Site-ID(s): eine oder mehrere kommagetrennt (z. B. default,filiale) oder * für alle Sites
UNIFI_SITE_ID=default
# Authentifizierung: API-Key (UniFi OS → Einstellungen → Control Plane → Integrationen)
UNIFI_API_KEY=
# … oder lokaler Benutzer (Read-Only-Admin empfohlen)
UNIFI_USERNAME=
UNIFI_PASSWORD=
# auto | unifios | classic  (auto erkennt UniFi OS vs. klassischen Controller)
UNIFI_CONTROLLER_TYPE=auto
# false für lokale Self-Signed-Zertifikate
UNIFI_VERIFY_SSL=false
# Abfrageintervall des Backends in ms
POLLING_INTERVAL_MS=5000
# Länge des In-Memory-Verlaufs (Minuten)
HISTORY_MINUTES=30
# Demo-Modus ohne Controller (simulierte Daten)
UNIFI_MOCK=false

# --- Zugangs-Gate (Stufe 1) -------------------------------------------
# Initiales Zugangspasswort; leer = nur Turnstile wird abgefragt
ACCESS_PASSWORD=
# Cloudflare Turnstile
TURNSTILE_ENABLED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Admin-Bereich (Stufe 2) ------------------------------------------
ADMIN_PASSWORD=

# --- Session -----------------------------------------------------------
# Mindestens 32 Zeichen, z. B.: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Secure-Flag am Cookie. Nur für Tests ohne HTTPS (http://IP:3004) auf false setzen!
COOKIE_SECURE=true

# --- Datenschutz -------------------------------------------------------
# Maskiert WAN-IP und Client-MACs für Besucher ohne Admin-Session
HIDE_SENSITIVE_IPS=true
