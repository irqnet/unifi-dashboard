# =====================================================================
#  UniFi Network Dashboard – configuration
#  Copy to .env and adjust:  cp .env.example .env
# =====================================================================

# --- UniFi controller --------------------------------------------------
# UniFi OS (UDM/UCG/Cloud Key Gen2+) or self-hosted controller
UNIFI_CONTROLLER_URL=https://192.168.1.1
# Site ID(s): one or more, comma-separated (e.g. default,branch), or * for all sites
UNIFI_SITE_ID=default
# Authentication: API key (UniFi OS → Settings → Control Plane → Integrations)
UNIFI_API_KEY=
# … or a local user (read-only admin recommended)
UNIFI_USERNAME=
UNIFI_PASSWORD=
# auto | unifios | classic  (auto detects UniFi OS vs. classic controller)
UNIFI_CONTROLLER_TYPE=auto
# false for local self-signed certificates
UNIFI_VERIFY_SSL=false
# Backend polling interval in ms
POLLING_INTERVAL_MS=5000
# Length of the in-memory history (minutes)
HISTORY_MINUTES=30
# Time zone for day/month boundaries of the WAN data volume (default UTC)
TZ=Europe/Berlin
# Fallback bandwidth in Mbit/s if no "Expected ISP Speeds" are set in UniFi
WAN_BANDWIDTH_DOWN_MBPS=
WAN_BANDWIDTH_UP_MBPS=
# Demo mode without a controller (simulated data)
UNIFI_MOCK=false

# --- Guest Wi-Fi vouchers (Admin → Vouchers, admins only) --------------
# Needs write access in UniFi (hotspot): the API key or user must NOT be read-only.
# Presets: Name=minutes,uses,upload kbit/s,download kbit/s,data limit MB; …
#   Uses: 1 = single use, 0 = unlimited, n = n devices. Empty fields = no limit.
#   The name is optional; without one the label is generated in the interface language.
VOUCHER_PRESETS=1440,1,,,;4320,1,,,;10080,3,,,
# SSID of the guest Wi-Fi (for printout + QR code); empty password = open network with portal
VOUCHER_WIFI_SSID=
VOUCHER_WIFI_PASSWORD=
# Require a note when creating / max. number per creation
VOUCHER_NOTE_REQUIRED=false
VOUCHER_MAX_BATCH=100

# --- Access gate (level 1) ---------------------------------------------
# Initial access password; empty = only Turnstile is required
ACCESS_PASSWORD=
# Cloudflare Turnstile
TURNSTILE_ENABLED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Admin area (level 2) ----------------------------------------------
ADMIN_PASSWORD=

# --- Session -----------------------------------------------------------
# At least 32 characters, e.g.: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Secure flag on the cookie. Only set to false for tests without HTTPS (http://IP:3004)!
COOKIE_SECURE=true

# --- Privacy -----------------------------------------------------------
# Masks the WAN IP and client MACs for visitors without an admin session
HIDE_SENSITIVE_IPS=true
